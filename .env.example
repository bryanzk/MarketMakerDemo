# MarketMakerDemo Environment Variables Template
# MarketMakerDemo 环境变量模板
#
# Copy this file to .env and fill in your actual values
# 复制此文件到 .env 并填写实际值
# DO NOT commit .env file to Git (already in .gitignore)
# 不要将 .env 文件提交到 Git（已在 .gitignore 中）

# ============================================================================
# Exchange API Credentials / 交易所 API 凭证
# ============================================================================

# Binance API Credentials (Optional if using Hyperliquid only)
# Binance API 凭证（如果仅使用 Hyperliquid 则为可选）
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Hyperliquid API Credentials / Hyperliquid API 凭证
# Required for Hyperliquid trading / Hyperliquid 交易必需
HYPERLIQUID_API_KEY=your_hyperliquid_api_key_here
HYPERLIQUID_API_SECRET=your_hyperliquid_api_secret_here

# Hyperliquid Network Configuration / Hyperliquid 网络配置
# Set to "true" for testnet, "false" for mainnet
# 设置为 "true" 使用测试网，"false" 使用主网
# Default: false
HYPERLIQUID_TESTNET=false

# Optional: Run Hyperliquid only (disable Binance)
# 可选：仅运行 Hyperliquid（禁用 Binance）
# Set to "true" to disable Binance instance
# 设置为 "true" 禁用 Binance 实例
# Default: false
HYPERLIQUID_ONLY=false

# ============================================================================
# LLM API Keys (Optional - for Multi-LLM Evaluation) / LLM API 密钥（可选 - 用于多 LLM 评估）
# ============================================================================

# Google Gemini API Key / Google Gemini API 密钥
# Optional: Required only if using Gemini for LLM evaluation
# 可选：仅在将 Gemini 用于 LLM 评估时需要
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key / OpenAI API 密钥
# Optional: Required only if using OpenAI for LLM evaluation
# 可选：仅在将 OpenAI 用于 LLM 评估时需要
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key / Anthropic Claude API 密钥
# Optional: Required only if using Claude for LLM evaluation
# 可选：仅在将 Claude 用于 LLM 评估时需要
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# Security Notes / 安全提示
# ============================================================================
#
# ⚠️ NEVER commit .env file to Git
# ⚠️ 永远不要将 .env 文件提交到 Git
#
# ⚠️ NEVER share API keys in public channels
# ⚠️ 不要在公共渠道分享 API 密钥
#
# ⚠️ Use testnet API keys for development and testing
# ⚠️ 在开发和测试中使用测试网 API 密钥
#
# ⚠️ Rotate API keys regularly for security
# ⚠️ 定期轮换 API 密钥以确保安全
